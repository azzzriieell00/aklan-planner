# Optional ArcGIS basemap API key. A browser key is PUBLIC, not a secret.
# Scope it to basemaps and restrict referrers to your actual app URLs.
# Without a key, the app displays the public World Imagery MapServer.
VITE_ARCGIS_API_KEY=

# Optional GitHub Pages project path, e.g. /aklan-planner/
# DEPLOY_BASE=/aklan-planner/
